import os
import re
from pptx import Presentation
from docx import Document
from google.colab import files

def clean_text(text):
    """清除 XML 不兼容的字符（核心修复逻辑）"""
    if not text:
        return ""
    # 匹配并剔除非法字符：除 \t, \n, \r 以外的控制字符
    # 范围为：00-08, 0B-0C, 0E-1F, 7F-84, 86-9F
    illegal_chars = re.compile(r'[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x84\x86-\x9f]')
    return illegal_chars.sub("", text)

def extract_ppt_to_word_safe(pptx_path, output_docx):
    """提取 PPT 且具备字符安全过滤功能"""
    if not os.path.exists(pptx_path):
        print(f"❌ 错误：找不到文件 {pptx_path}")
        return False

    try:
        prs = Presentation(pptx_path)
        doc = Document()
        doc.add_heading('PPT 内容提取报告 (已清洗非法字符)', 0)

        print(f"🚀 正在分析文件并清洗字符: {pptx_path}...")

        for i, slide in enumerate(prs.slides):
            # 添加页码标题
            doc.add_heading(f'第 {i+1} 页', level=1)

            for shape in slide.shapes:
                # 1. 提取文本框和形状文字
                if hasattr(shape, "text") and shape.text.strip():
                    safe_text = clean_text(shape.text.strip())
                    doc.add_paragraph(safe_text)

                # 2. 提取表格内容
                if shape.has_table:
                    table = shape.table
                    word_table = doc.add_table(rows=len(table.rows), cols=len(table.columns))
                    word_table.style = 'Table Grid'

                    for r_idx, row in enumerate(table.rows):
                        for c_idx, cell in enumerate(row.cells):
                            safe_cell_text = clean_text(cell.text.strip())
                            word_table.cell(r_idx, c_idx).text = safe_cell_text

            doc.add_paragraph()

        # 保存 Word 文件
        doc.save(output_docx)
        print(f"✅ 解析成功！Word 文件已生成: {output_docx}")
        return True
    except Exception as e:
        print(f"❌ 依然报错: {e}")
        return False

if __name__ == "__main__":
    print("👇 请点击下方按钮上传报错的那个 PPT 文件：")
    uploaded = files.upload()

    if not uploaded:
        print("⚠️ 未选择文件。")
    else:
        input_ppt = list(uploaded.keys())[0]
        output_name = os.path.splitext(input_ppt)[0] + "_cleaned.docx"

        if extract_ppt_to_word_safe(input_ppt, output_name):
            print(f"正在自动下载: {output_name}")
            files.download(output_name)
