import os
import re
import tempfile
from pptx import Presentation
from pptx.enum.shapes import MSO_SHAPE_TYPE, PP_PLACEHOLDER
from docx import Document
from docx.shared import Pt, RGBColor, Inches
from google.colab import files

# ==========================================
# 第二步：核心处理逻辑
# ==========================================

def clean_text(text):
    """清洗文本，去除换行符和特殊字符，保持单行"""
    if not text:
        return ""
    # 替换换行符为空格，避免破坏 Markdown 结构
    text = text.replace("\n", " ").replace("\r", "")
    # 去除多余空格
    text = re.sub(r'\s+', ' ', text).strip()
    return text

def extract_ppt_to_word(ppt_path, output_path):
    """
    将 PPT 转换为结构化 Word 文档
    优化点：
    1. 标题去重（连续相同标题只显示一次）
    2. 保留原始图片（新增核心功能）
    3. 移除无用标签
    4. 修复 shape 属性报错
    """
    prs = Presentation(ppt_path)
    doc = Document()
    last_title = None  # 用于记录上一页的标题，实现去重
    
    # 创建临时目录存储提取的图片（Colab 环境必须）
    with tempfile.TemporaryDirectory() as tmpdir:
        print(f"🚀 正在解析 PPT: {os.path.basename(ppt_path)} ...")

        for slide_num, slide in enumerate(prs.slides, start=1):
            current_slide_title = None
            slide_elements = []  # 改为存储混合元素（文本+图片路径）

            # --- 1. 遍历形状提取内容（文本+图片）---
            for shape in slide.shapes:
                # 处理文本内容
                if shape.has_text_frame:
                    text = clean_text(shape.text)
                    if text:
                        # 判断是否为标题（逻辑保持不变）
                        is_title = False
                        try:
                            if shape.shape_type == MSO_SHAPE_TYPE.PLACEHOLDER:
                                ph_format = shape.placeholder_format
                                if ph_format.idx in [0, 1] or "Title" in str(ph_format.name):
                                    is_title = True
                        except ValueError:
                            pass

                        if not is_title and shape.has_text_frame:
                            first_run_font_size = 0
                            for para in shape.text_frame.paragraphs:
                                if para.runs and para.runs[0].font.size:
                                    first_run_font_size = max(first_run_font_size, para.runs[0].font.size)
                            if first_run_font_size > 356000:
                                is_title = True

                        # 标题单独处理，不混入内容流
                        if is_title:
                            current_slide_title = text
                        else:
                            slide_elements.append(("text", text))

                # === 新增：处理图片 ===
                elif shape.shape_type == MSO_SHAPE_TYPE.PICTURE:
                    try:
                        # 提取图片二进制数据
                        image = shape.image
                        img_bytes = image.blob
                        # 生成唯一文件名（防止重名）
                        img_path = os.path.join(tmpdir, f"slide{slide_num}_{image.filename}")
                        # 保存到临时目录
                        with open(img_path, 'wb') as img_file:
                            img_file.write(img_bytes)
                        # 记录图片位置信息
                        slide_elements.append(("image", img_path))
                    except Exception as e:
                        print(f"⚠️ 跳过图片 (Slide {slide_num}): {str(e)}")

            # --- 2. 写入 Word 文档（按原始顺序混合插入）---
            
            # A. 处理标题 (去重)
            if current_slide_title:
                if current_slide_title != last_title:
                    doc.add_heading(current_slide_title, level=1)
                    last_title = current_slide_title

            # B. 按原始顺序插入文本和图片
            for elem_type, content in slide_elements:
                if elem_type == "text":
                    # 文本块处理（保持原有逻辑）
                    p = doc.add_paragraph(content)
                    p.style = doc.styles['Normal']
                elif elem_type == "image":
                    # === 新增：插入图片 ===
                    # 自动调整图片尺寸（最大宽度6英寸，保持比例）
                    try:
                        # 获取原始图片尺寸
                        from PIL import Image
                        with Image.open(content) as img:
                            width, height = img.size
                            aspect_ratio = width / height
                            # 设置最大宽度为6英寸（Word页面宽度约6.5英寸）
                            target_width = min(6.0, aspect_ratio * 4.0)  # 宽高比自适应
                            doc.add_picture(content, width=Inches(target_width))
                        # 添加图片说明（可选）
                        # doc.add_paragraph("[图示]", style='Caption')
                    except Exception as e:
                        print(f"⚠️ 图片插入失败: {str(e)}")

            # 每页内容间添加分隔（可选，提高可读性）
            if slide_num < len(prs.slides):
                doc.add_paragraph("\n" + "-"*50 + "\n")

        # 保存文件
        doc.save(output_path)
        print(f"✅ 转换完成！已保存为: {output_path}")
        return output_path

# ==========================================
# 第三步：执行入口
# ==========================================

# 1. 上传文件
print("请上传您的 PPTX 文件...")
uploaded = files.upload()

if uploaded:
    # 获取上传的文件名
    input_filename = list(uploaded.keys())[0]

    # 定义输出文件名
    output_filename = f"{os.path.splitext(input_filename)[0]}_KB_Ready.docx"

    # 2. 执行转换
    try:
        result_path = extract_ppt_to_word(input_filename, output_filename)

        # 3. 下载结果
        files.download(result_path)

    except Exception as e:
        print(f"❌ 发生严重错误: {e}")
else:
    print("未检测到上传文件，请重新运行单元格并选择文件。")
